
	{
	"name": "Sakura-Mochi-N-Matcha",
	"type":"light",
	
	"colors": {

		//Panel color

		"panel.background":"#ffccd5",
		"panel.border":"#023436",
		"panelTitle.inactiveForeground":"#58641D",
		"panelTitle.activeForeground":"#CAD178",
		"panelTitleBadge.background":"#CAD178",
		"panelTitle.activeBorder":"#273B09",
		"terminal.background": "#CAD178",        // Background of the terminal itself (if you want it to match)
        "terminal.foreground": "#333333",

		// Window and title bar 
		"titleBar.activeBackground":"#58641D",
		"titleBar.activeForeground":"#fff3b0",
		"titleBar.inactiveBackground":"#CAD182",
		"titleBar.inactiveForeground": "#273B09",
		"window.activeBorder":"#002400",

		//Sidebar
		"activityBar.activeFocusBorder":"#CAD178",
		"activityBar.foreground":"#fff3b0",
		"sideBar.background":"#CAD182",
		"sideBar.foreground":"#023436",
		"sideBarTitle.foreground":"#648767",
		"sideBarSectionHeader.background":"#023436",
		"sideBarSectionHeader.foreground":"#FEEAC7",


		

		//Editor area
		"editor.background": "#fff3b0",
		"editor.foreground": "#648767",
        "list.activeSelectionIconForeground": "#CAD182",
		"editor.lineHighlightBackground":"#FFF099",
		"editorLineNumber.activeForeground": "#724319",
		"editorLineNumber.foreground":"#a98467",

		//Tabs
		"editorGroupHeader.tabsBackground": "#CAD182",
		"tab.activeBackground": "#F7B1B0",
		"tab.activeForeground": "#648767",
		"tab.inactiveBackground": "#58641D",
		"activityBar.background": "#CAD178",
		"activityBar.border": "#3A4114",
  
		//Status Bar

		"statusBar.background": "#ffccd5",
		"statusBar.foreground": "#023436",
		"statusBar.debuggingBackground":"#CAD182",
		"statusBarItem.remoteBackground":"#fff3b0",
		"statusBar.noFolderBackground": "#ffccd5",
		"statusBar.noFolderForeground": "#58641D",
		"statusBarItem.hoverBackground":"#F7B1B0",

		//for the brackets 

		"editorBracketHighlight.foreground1": "#590d22",
		"editorBracketHighlight.foreground2": "#800f2f",
		"editorBracketHighlight.foreground3": "#a4133c",
		"editorBracketHighlight.foreground4": "#a4133c",
		"editorBracketHighlight.foreground5": "#590d22",
		"editorBracketHighlight.foreground6": "#a4133c",
		"editorBracketHighlight.unexpectedBracket.foreground": "#a4133c"

	},

	"tokenColors": [
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#ff8fa3"
			}
		},
		{
			"name": "Comments: Preprocessor",
			"scope": "comment.block.preprocessor",
			"settings": {
				"fontStyle": "",
				"foreground": "#ff8fa3"
			}
		},
		{
			"name": "Comments: Documentation",
			"scope": [
				"comment.documentation",
				"comment.block.documentation"
			],
			"settings": {
				"foreground": "#ff8fa3"
			}
		},
		{
			"name": "Invalid - Illegal",
			"scope": "invalid.illegal",
			"settings": {
				"foreground": "#800f2f"
			}
		},
		{
			"name": "Operators",
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#ff4d6d"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage"
			],
			"settings": {
				"foreground": "#c9184a"
			}
		},
		{
			"name": "Types",
			"scope": [
				"storage.type",
				"support.type"
			],
			"settings": {
				"foreground": "#ff758f"
			}
		},
		{
			"name": "Language Constants",
			"scope": [
				"constant.language",
				"support.constant",
